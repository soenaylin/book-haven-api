generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    role      Role     @default(USER)
    createdAt DateTime @default(now())
    // addresses      Address[]
    // cart           Cart?
    // notifications  Notification[]
    // orders         Order[]
    // recentlyViewed RecentlyViewed[]
    // reviews        Review[]
    // wishlist       WishlistItem[]
}

enum Role {
    USER
    ADMIN
}
