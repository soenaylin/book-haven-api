generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model User {
    id            String         @id @default(uuid())
    name          String
    email         String         @unique
    password      String
    role          Role           @default(USER)
    createdAt     DateTime       @default(now())
    addresses     Address[]
    cart          Cart?
    notifications Notification[]
    orders        Order[]
    // recentlyViewed RecentlyViewed[]
    reviews       Review[]
    wishlist      WishlistItem[]
}

model Book {
    id          String         @id @default(uuid())
    title       String
    author      String         @default("Unknown Author")
    description String
    price       Float
    isbn        String?
    stock       Int
    coverImage  String
    categoryId  String
    createdAt   DateTime       @default(now())
    salesCount  Int            @default(0)
    category    Category       @relation(fields: [categoryId], references: [id])
    cartItems   CartItem[]
    orderItems  OrderItem[]
    // recentlyViewed RecentlyViewed[]
    reviews     Review[]
    wishlist    WishlistItem[]
}

model Category {
    id    String @id @default(uuid())
    name  String @unique
    books Book[]
}

model Cart {
    id     String     @id @default(uuid())
    userId String     @unique
    user   User       @relation(fields: [userId], references: [id])
    items  CartItem[]
}

model CartItem {
    id       String @id @default(uuid())
    cartId   String
    bookId   String
    quantity Int
    cart     Cart   @relation(fields: [cartId], references: [id])
    book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

    @@unique([cartId, bookId])
}

model Order {
    id             String      @id @default(uuid())
    userId         String
    status         OrderStatus @default(PENDING)
    subtotal       Float       @default(0)
    shippingCost   Float       @default(0)
    discountAmount Float       @default(0)
    totalPrice     Float
    promoCode      String?
    addressId      String
    createdAt      DateTime    @default(now())
    user           User        @relation(fields: [userId], references: [id])
    address        Address     @relation(fields: [addressId], references: [id])
    items          OrderItem[]
}

model PromoCode {
    id             String    @id @default(uuid())
    code           String    @unique
    description    String?
    discount       Float
    type           PromoType @default(PERCENTAGE)
    minPurchase    Float     @default(0)
    maxDiscount    Float?
    expiryDate     DateTime?
    isActive       Boolean   @default(true)
    oneTimePerUser Boolean   @default(false)
    usageCount     Int       @default(0)
    usageLimit     Int?
    createdAt      DateTime  @default(now())
}

model OrderItem {
    id       String @id @default(uuid())
    orderId  String
    bookId   String
    price    Float
    quantity Int
    order    Order  @relation(fields: [orderId], references: [id])
    book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Address {
    id          String  @id @default(uuid())
    userId      String
    fullName    String
    phone       String
    addressLine String
    city        String
    country     String
    user        User    @relation(fields: [userId], references: [id])
    orders      Order[]
}

model WishlistItem {
    id        String   @id @default(uuid())
    userId    String
    bookId    String
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id])
    book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

    @@unique([userId, bookId])
}

model Review {
    id        String   @id @default(uuid())
    userId    String
    bookId    String
    rating    Int
    comment   String?
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id])
    book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

    @@unique([userId, bookId])
}

model Notification {
    id        String   @id @default(uuid())
    userId    String
    title     String
    message   String
    type      String
    read      Boolean  @default(false)
    link      String?
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id])
}

enum PromoType {
    PERCENTAGE
    FIXED
}

enum Role {
    USER
    ADMIN
}

enum OrderStatus {
    PENDING
    PAID
    SHIPPED
    DELIVERED
    CANCELLED
}
