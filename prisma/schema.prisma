generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    role      Role     @default(USER)
    createdAt DateTime @default(now())
    // addresses      Address[]
    // cart           Cart?
    // notifications  Notification[]
    // orders         Order[]
    // recentlyViewed RecentlyViewed[]
    // reviews        Review[]
    // wishlist       WishlistItem[]
}

model Book {
    id          String   @id @default(uuid())
    title       String
    author      String   @default("Unknown Author")
    description String
    price       Float
    isbn        String?
    stock       Int
    coverImage  String
    categoryId  String
    createdAt   DateTime @default(now())
    salesCount  Int      @default(0)
    category       Category         @relation(fields: [categoryId], references: [id])
    // cartItems      CartItem[]
    // orderItems     OrderItem[]
    // recentlyViewed RecentlyViewed[]
    // reviews        Review[]
    // wishlist       WishlistItem[]
}

model Category {
    id    String @id @default(uuid())
    name  String @unique
    books Book[]
}

enum Role {
    USER
    ADMIN
}
