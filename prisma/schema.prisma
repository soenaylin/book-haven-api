generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model User {
    id            String         @id @default(uuid())
    name          String
    email         String         @unique
    password      String
    role          Role           @default(USER)
    createdAt     DateTime       @default(now())
    addresses      Address[]
    cart          Cart?
    // notifications  Notification[]
    // orders         Order[]
    // recentlyViewed RecentlyViewed[]
    // reviews        Review[]
    // wishlist       WishlistItem[]
    notifications Notification[]
}

model Book {
    id          String     @id @default(uuid())
    title       String
    author      String     @default("Unknown Author")
    description String
    price       Float
    isbn        String?
    stock       Int
    coverImage  String
    categoryId  String
    createdAt   DateTime   @default(now())
    salesCount  Int        @default(0)
    category    Category   @relation(fields: [categoryId], references: [id])
    cartItems   CartItem[]
    // orderItems     OrderItem[]
    // recentlyViewed RecentlyViewed[]
    // reviews        Review[]
    // wishlist       WishlistItem[]
}

model Category {
    id    String @id @default(uuid())
    name  String @unique
    books Book[]
}

model Cart {
    id     String     @id @default(uuid())
    userId String     @unique
    user   User       @relation(fields: [userId], references: [id])
    items  CartItem[]
}

model CartItem {
    id       String @id @default(uuid())
    cartId   String
    bookId   String
    quantity Int
    cart     Cart   @relation(fields: [cartId], references: [id])
    book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

    @@unique([cartId, bookId])
}

model PromoCode {
    id             String    @id @default(uuid())
    code           String    @unique
    description    String?
    discount       Float
    type           PromoType @default(PERCENTAGE)
    minPurchase    Float     @default(0)
    maxDiscount    Float?
    expiryDate     DateTime?
    isActive       Boolean   @default(true)
    oneTimePerUser Boolean   @default(false)
    usageCount     Int       @default(0)
    usageLimit     Int?
    createdAt      DateTime  @default(now())
}

model Address {
    id          String  @id @default(uuid())
    userId      String
    fullName    String
    phone       String
    addressLine String
    city        String
    country     String
    user        User    @relation(fields: [userId], references: [id])
    // orders      Order[]
}

model Notification {
    id        String   @id @default(uuid())
    userId    String
    title     String
    message   String
    type      String
    read      Boolean  @default(false)
    link      String?
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id])
}

enum PromoType {
    PERCENTAGE
    FIXED
}

enum Role {
    USER
    ADMIN
}
